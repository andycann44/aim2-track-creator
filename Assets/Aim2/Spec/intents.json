{ "intents": [{ "name": "set-track-dimensions", "regex": "\\b(\\d+)\\s*m\\s*(?:by|x|\\*)\\s*(\\d+)\\s*m\\b", "ops": [ { "op": "set", "path": "$.track.length", "value": "$1:int" }, { "op": "set", "path": "$.track.width", "value": "$2:int" } ] },{ "name": "set-missing-tiles-percent", "regex": "\\b(\\d+)\\s*%\\s*(?:tiles\\s*)?missing\\b", "ops": [ { "op": "set", "path": "$.track.missingTileChance", "value": "$1:int" } ] },{ "name": "set-gap-percent", "regex": "\\b(\\d+)\\s*%\\s*gaps?\\b", "ops": [ { "op": "set", "path": "$.track.gapChance", "value": "$1:int" } ] },{ "name": "set-curve-rows", "regex": "\\b(left|right)\\s+curve\\s+over\\s+(\\d+)\\s+rows?\\b", "ops": [ { "op": "set", "path": "$.track.curve.side", "value": "$1" }, { "op": "set", "path": "$.track.curve.rows", "value": "$2:int" } ] } ] }